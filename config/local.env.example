# Copy to config/local.env to pin where the dependencies live. ./install.sh
# writes this file for you; it is gitignored, so your paths never reach a
# commit and never collide with anyone else's.
#
#   cp config/local.env.example config/local.env && $EDITOR config/local.env
#
# Every line uses `: "${VAR:=...}"`, which means "default, unless already set".
# So anything you export in your shell still wins over this file.

# Parent directory holding ardupilot/ and ardupilot_gazebo/.
: "${SSS_ROOT:=$HOME/swarm-deps}"

# Override individually if your checkouts are not side by side.
: "${ARDUPILOT:=$SSS_ROOT/ardupilot}"
: "${ARDUPILOT_GAZEBO:=$SSS_ROOT/ardupilot_gazebo}"
: "${MISSION_PLANNER:=$SSS_ROOT/MissionPlanner}"

# Dashboard HTTP port, if 8760 is taken.
# : "${DASHBOARD_HTTP_PORT:=8760}"
